---
# Start at `moderate`; CI also runs `production` as an advisory step so the
# remaining gap is visible without blocking. Bump this line when that's clean.
profile: moderate

offline: true

exclude_paths:
  - .cache/
  - .ansible/
  - .github/
  - .githooks/
  - Makefile
  - README.md
  - setup.sh
  - .gitignore

kinds:
  - playbook: "playbook.yml"
  - tasks: "tasks/**/*.yml"
  - vars: "vars/**/*.yml"

skip_list:
  - yaml[commas]
